// ThermaVita Hydro 사용 가이드 앱 — 데이터 모델
// 기능정의서_초안.md 기준. 실제 제품 스펙(희석배수/EC·pH 등)은 GuideContent에서
// 관리자가 나중에 채워 넣을 수 있도록 값 컬럼을 nullable로 둠.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationMethod {
  DRIP // 관주식 양액공급
  FOLIAR // 엽면살포
}

enum AdminRole {
  OWNER
  EDITOR
}

// --- 사용자 (MG-01) ---
model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  passwordHash        String
  name                String
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  farmProfile         FarmProfile?
  crops               RegisteredCrop[]

  @@map("users")
}

// --- 재배환경 (CM-02, S-15b) — 농장 시스템 프로필, 사용자당 1개 ---
model FarmProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemType String? // 예: "순환식(NFT)", "담액식", "점적식"
  updatedAt  DateTime @updatedAt

  @@map("farm_profiles")
}

// --- 등록 작물 (HM-01~04, GD-11) — 홈 화면 "적용 현황" 카드 단위 ---
model RegisteredCrop {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropName   String // 예: "케일"
  method     ApplicationMethod
  createdAt  DateTime          @default(now())
  schedules  Schedule[]
  histories  UsageHistory[]

  @@map("registered_crops")
}

// --- 관주 일정 (MG-02,03, S-11/S-11b) ---
model Schedule {
  id               String         @id @default(cuid())
  registeredCropId String
  registeredCrop   RegisteredCrop @relation(fields: [registeredCropId], references: [id], onDelete: Cascade)
  scheduledDate    DateTime
  repeatRule       String? // 예: "매주", "격주", 자유 텍스트(1차 버전)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("schedules")
}

// --- 사용 이력 (MG-04,05, S-12/S-13) ---
model UsageHistory {
  id               String         @id @default(cuid())
  registeredCropId String
  registeredCrop   RegisteredCrop @relation(fields: [registeredCropId], references: [id], onDelete: Cascade)
  appliedDate      DateTime
  dilutionRatio    Int? // 예: 500 (500배)
  amountLiters     Float?
  memo             String?
  createdAt        DateTime       @default(now())

  @@map("usage_histories")
}

// --- 제품 정보 (PL-03,04,05, S-04) — 단일 제품이지만 향후 확장 대비 테이블화 ---
model Product {
  id                String   @id @default(cuid())
  name              String   @default("ThermaVita Hydro")
  ingredientSummary String? // 원료 설명
  filtrationNote    String? // 여과·정제 특성 설명
  phEcStabilityNote String? // pH/EC 안정성 설명
  imageAssetId      String? // 업로드된 제품 사진 asset id (미정 시 null → 플레이스홀더)
  updatedAt         DateTime @updatedAt

  @@map("products")
}

// --- 가이드 콘텐츠 (AD-03, GD-03~10) — 작물×적용방법 조합별 사용법 ---
// 값이 비어있으면(null) 프런트에서 "확인 필요" 플레이스홀더로 표시
model GuideContent {
  id             String            @id @default(cuid())
  cropName       String
  method         ApplicationMethod
  dilutionRatio  Int? // 희석배수
  usageNote      String? // 기본 사용법 설명

  // 관주식 전용 (GD-04,05,06)
  mixingSteps    String? // 양액 혼화 절차(줄바꿈 구분 텍스트, 1차 버전)
  ecMin          Float?
  ecMax          Float?
  phMin          Float?
  phMax          Float?
  cycleNote      String? // 순환·공급 주기 설명

  // 엽면살포 전용 (GD-07,08)
  sprayMethodNote String? // 살포 방법 설명
  sprayCycleNote  String? // 살포 주기 설명

  updatedAt      DateTime @updatedAt

  @@unique([cropName, method])
  @@map("guide_contents")
}

// --- 폭염 대응 시점 안내 (GD-09) — 공통 콘텐츠, 단일 레코드 ---
model HeatTimingGuide {
  id      String @id @default(cuid())
  content String // 안내 본문(1차 버전은 텍스트 블록)

  @@map("heat_timing_guides")
}

// --- 공지사항 (CM-01, AD-04) ---
model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  isUrgent  Boolean  @default(false) // true면 홈 상단 경고색 배너로 별도 노출
  createdAt DateTime @default(now())

  @@map("notices")
}

// --- 관리자 (AD-01) ---
model Admin {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  role                AdminRole @default(EDITOR)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())

  @@map("admins")
}
